# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CHANNEL_REDIS_URL=

# Optional WhatsApp kitchen alerts (Meta WhatsApp Cloud API)
WHATSAPP_ALERTS_ENABLED=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO_PHONE=

# Alerta diaria de stock minimo por Telegram (ver varagrill/alertas_stock.py)
# Token del bot (@BotFather) y chats que reciben el aviso, separados por coma.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Hora (0-23, hora de Venezuela) a partir de la cual sale el aviso del dia. Por defecto 8.
TELEGRAM_ALERTA_STOCK_HORA=8

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=varagrilldb
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432
