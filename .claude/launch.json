{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "varagrill-dev",
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "varagrill-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "varagrill-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "varagrill-dev-verif",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["manage.py", "runserver", "127.0.0.1:8010"],
      "port": 8010
    }
  ]
}
